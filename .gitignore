# Publish only the maintained Python Actor and portable development files.
/*
!/.gitignore
!/.dockerignore
!/.actorignore
!/Dockerfile
!/requirements.txt
!/pyproject.toml
!/README.md
!/CLOUD_PREPARATION.md
!/input.example.json
!/.actor/
!/.vscode/
!/src/
!/tests/
!/scripts/

/.actor/*
!/.actor/*.json
/.vscode/*
!/.vscode/launch.json
!/.vscode/settings.json
/src/*
!/src/*.py
/tests/*
!/tests/test_*.py
/scripts/*
!/scripts/validate.py

# Runtime/private artifacts: never publish.
/.venv/
/node_modules/
/storage/
/reports/
/output/
/backups/
/captures/
/.cache/
/.tmp/
/.validation/
/legacy-node/
**/__pycache__/
*.pyc
*.zip
**/.env
**/.env.*
*.pem
*.key
*.p12
*.pfx
**/cookies*
**/browser-profile*
