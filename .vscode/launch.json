{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Back Market — Extraer producto",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--input",
        "storage/key_value_stores/default/INPUT_BACKMARKET.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "APIFY_TOKEN": null,
        "APIFY_IS_AT_HOME": "0",
        "BACKMARKET_F5": "1",
        "APIFY_PURGE_ON_START": "false",
        "ACTOR_INPUT_KEY": "INPUT_BACKMARKET",
        "PYTHON_DOTENV_DISABLED": "1",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1"
      }
    }
  ]
}
